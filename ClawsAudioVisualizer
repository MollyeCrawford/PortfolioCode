function keyPressed(){
  if (key === ' ' || keyCode === 32) {
    if (song && song.isPlaying()) {
      song.pause();
    } else {
      if(song) {
        song.play();
      }
    }
    return false;
  }
}

function heart(x, y, s) {
  beginShape();
  vertex(x, y);
  bezierVertex(x - s / 2, y - s / 2, x - s, y + s / 3, x, y + s);
  bezierVertex(x + s, y + s / 3, x + s / 2, y - s / 2, x, y);
  endShape(CLOSE);
}

// Calculate distance from a point to the edge of a heart shape
function heartDistance(px, py, centerX, centerY, scale) {
  // Translate and normalize point to heart-centered coordinates
  let x = (px - centerX) / scale;
  let y = (py - centerY) / scale;
  
  // Heart points down
  y = -y;
  
  // Heart implicit equation: (x^2 + y^2 - 1)^3 - x^2 * y^3 = 0
  
  // For each point, sample radially outward to find the heart boundary
  let angle = atan2(y, x);
  
  // Binary search for the heart boundary in this direction
  let minR = 0;
  let maxR = 3;
  let steps = 20;
  
  for(let i = 0; i < steps; i++) {
    let r = (minR + maxR) / 2;
    let testX = r * cos(angle);
    let testY = r * sin(angle);
    
    // Evaluate heart equation
    let val = pow(testX * testX + testY * testY - 1, 3) - testX * testX * pow(testY, 3);
    
    if(val < 0) {
      minR = r;
    } else {
      maxR = r;
    }
  }
  
  let heartRadius = (minR + maxR) / 2;
  let currentRadius = dist(0, 0, x, y);
  
  return abs(currentRadius - heartRadius) * scale;
}
