function setup() {
  createCanvas(1500, 1000);
  
  // Heart background setup
  cols = floor(width/heartSize); 
  rows = floor(height/heartSize);
  
  amplitude = new p5.Amplitude();
  
  max = sqrt(pow(width/2, 2) + pow(height/2, 2));
  

  let heartScale = min(width, height) / 6; 
  
  for(let i=0; i<cols; i++) {
    d[i] = [];
    for (let j=0; j<rows; j++) {
      let x = i * heartSize + heartSize/2;
      let y = j * heartSize + heartSize/2; 
     
      d[i][j] = heartDistance(x, y, width/2, height/2, heartScale);
    }
  }
  
  // Lyrics convert to character array
  lyricChars = lyrics.split('');
  lyricChars = lyricChars.filter(char => char !== '\n'); // Remove newlines
  
  // Text rain setup
  textFont('monospace');
  textSize(fontSize);
  textStyle(BOLD); // Make text bold
  textAlign(CENTER, CENTER);
  
  charWidth = textWidth('W');
  charHeight = fontSize * 1.2;
  
  // Calculate columns 
  rainCols = floor(width / (charWidth * 3)); 
  
  // Initialize rain drops 
  for(let i = 0; i < rainCols; i++) {
    rainDrops[i] = [];
    let numDrops = 1;
    for(let j = 0; j < numDrops; j++) {
      rainDrops[i].push({
        y: random(-height * 2, 0),
        speed: random(1, 5),
        charIndex: floor(random(lyricChars.length)),
        trailLength: floor(random(15, 30)),
        size: random([20, 25, 35, 45, 55]) 
      });
    }
  }
}

function draw() {
  // Draw heart background
  background(220);
  noStroke();
  
  let level = amplitude.getLevel();
  
  for(let i=0; i<cols; i++) {
    for (let j=0; j<rows; j++) {
      let x = i * heartSize + heartSize/2;
      let y = j * heartSize + heartSize/2; 
      let index = floor(map(abs(d[i][j]), 0, max, 0, colors.length * rings));
      
      let c = colors[index % colors.length];
      fill(c);
      
      heart(x, y, heartSize);
      
      d[i][j] -= level * 50;
      
      if(d[i][j] < -max) {
        d[i][j] = max; 
      }
    }
  }
  
  // Start button/is song playing
  if(!song || !song.isPlaying()) {
    fill(0);
    textSize(24);
    textAlign(CENTER, CENTER);
    text("Press space to start", width/2, height/2);
    textSize(fontSize); // Reset
    textAlign(CENTER, CENTER);
  }
  
  // Draw text rain
  for(let i = 0; i < rainCols; i++) {
    for(let raindrop of rainDrops[i]) {
      // Set size for this raindrop
      textSize(raindrop.size);
      
      // Draw trail of characters
      for(let t = 0; t < raindrop.trailLength; t++) {
        let yPos = raindrop.y - t * charHeight * (raindrop.size / fontSize);
        
        if(yPos > -charHeight && yPos < height + charHeight) {
          // Get character from lyrics
          let charIdx = (raindrop.charIndex + t) % lyricChars.length;
          let char = lyricChars[charIdx];
          
          // Fade effect, solid black at front with a fading trail
          let alpha = map(t, 0, raindrop.trailLength, 255, 0);
          
          // Black text with fade
          fill(0, 0, 0, alpha);
          
          text(char, i * charWidth * 3 + charWidth/2, yPos); // Multiply spacing by 3
        }
      }
      
      // Update position 
      raindrop.y += raindrop.speed * (1 + level * 5); 
      
      // Cycle through lyrics
      if(frameCount % 2 === 0) {
        raindrop.charIndex = (raindrop.charIndex + 1) % lyricChars.length;
      }
      
      // Reset when off screen
      if(raindrop.y > height + 200) {
        raindrop.y = -random(200, 800);
        raindrop.speed = random(1, 5); // Slower speed
        raindrop.charIndex = floor(random(lyricChars.length));
        raindrop.trailLength = floor(random(15, 30));
        raindrop.size = random([20, 25, 30, 45, 55]); 
      }
    }
  }
}

